# Pusher Channels — https://pusher.com (free tier: 100 connections, 200k msg/day)
# Create an app at pusher.com → Channels → Create App
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=mt1

# These are exposed to the browser (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_PUSHER_KEY=your_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Upstash Redis — https://upstash.com (free tier: 10k commands/day)
# Create a database at console.upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token
